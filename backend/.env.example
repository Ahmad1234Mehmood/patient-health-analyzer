# Copy to .env and edit if needed
ENVIRONMENT=development
BACKEND_PORT=5000
FRONTEND_URL=http://localhost:5173

# Mains (powerline) frequency used by the notch filter. 50 in Europe/Asia, 60 in the Americas.
MAINS_HZ=50

# Max upload size in MB (ECG / X-ray uploads)
MAX_UPLOAD_MB=64

# Where datasets live (defaults shown). Put real PhysioNet / MIMIC-CXR / Montgomery data here.
# DATA_DIR=./data
